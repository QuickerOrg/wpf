<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <!-- README 的构建输出位于 ./artifacts，排除以免另一 RID 的生成文件被编译 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
    <DemoUsePackage Condition="'$(DemoUsePackage)' == ''">true</DemoUsePackage>
    <DefineConstants Condition="'$(DemoUsePackage)' == 'true'">$(DefineConstants);DEMO_PACKAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DemoUsePackage)' == 'true'">
    <PackageReference Include="WpfD3D11Runtime" Version="[10.0.14-d3d11.4]" />
  </ItemGroup>
</Project>
